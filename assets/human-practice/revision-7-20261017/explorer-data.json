  "records": [
    {
      "number": 1,
      "title": "Listening to the Public",
      "summaries": [
        "Collected public feedback through surveys and interactive activities, revealing demand for portable respiratory pathogen testing."
      ],
      "photos": [
        "image1.jpeg"
      ],
      "sourceBlock": 13,
      "type": "SURVEY"
    },
    {
      "number": 2,
      "title": "Random Interviews at the Third Hospital of Harbin Medical University",
      "summaries": [
        "Visited pediatric and geriatric departments, identifying mobility barriers and cross-infection risks that support local screening."
      ],
      "photos": [
        "image2.jpeg"
      ],
      "sourceBlock": 17,
      "type": "FIELD VISIT"
    },
    {
      "number": 3,
      "title": "Interviews with Nursing Home Care Workers and Residents",
      "summaries": [
        "Interviewed nursing home staff and residents, identifying the need for simple, rapid, on-site infection screening."
      ],
      "photos": [
        "image3.jpeg"
      ],
      "sourceBlock": 21,
      "type": "SURVEY"
    },
    {
      "number": 4,
      "title": "Interview with Professor Li Juan, Former Dean of the School of Public Health, Jilin University",
      "summaries": [
        "Discussed primary-care needs with Professor Li Juan, Former Dean of the School of Public Health, Jilin University, defining a portable, rapid, multiplex pathogen detection goal."
      ],
      "photos": [
        "image4.png"
      ],
      "sourceBlock": 25,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 5,
      "title": "Roundtable with Public Health and Disease Control Experts",
      "summaries": [
        "Consulted disease-control experts to position ByeGerm as a community early-warning node and draft an emergency response guide."
      ],
      "photos": [
        "image5.jpeg"
      ],
      "sourceBlock": 30,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 6,
      "title": "Interview with Vice Dean Changgui Kou of the School of Public Health, Jilin University",
      "summaries": [
        "Used epidemiological guidance to select five respiratory targets: RSV, hMPV-B, SPN, BP, and HI."
      ],
      "photos": [
        "image6.png"
      ],
      "sourceBlock": 34,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 7,
      "title": "Interview with Dr. Junyao Li, Respiratory Medicine",
      "summaries": [
        "Consulted respiratory clinicians to define ByeGerm as an out-of-hospital preliminary screening tool, not a laboratory replacement."
      ],
      "photos": [
        "image7.jpeg"
      ],
      "sourceBlock": 38,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 8,
      "title": "Interview with Dr. Huimin Li, Laboratory Medicine",
      "summaries": [
        "Confirmed that on-site screening should complement, not replace, standardized laboratory confirmation."
      ],
      "photos": [
        "image8.jpeg"
      ],
      "sourceBlock": 42,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 9,
      "title": "Interview with Dr. Shangwei Ji, Infectious Diseases",
      "summaries": [
        "Discussed on-site risk stratification to guide observation, isolation, and referral decisions."
      ],
      "photos": [
        "image9.jpeg"
      ],
      "sourceBlock": 46,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 10,
      "title": "Interview with Dr. Xin Tian, Pediatrics",
      "summaries": [
        "Identified kindergarten and home screening opportunities to help caregivers recognize pediatric respiratory risks earlier."
      ],
      "photos": [
        "image10.jpeg"
      ],
      "sourceBlock": 50,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 11,
      "title": "Interview with Professor X. Chris Le, University of Alberta",
      "summaries": [
        "Adopted expert advice to pursue a portable, one-pot RPA–CRISPR/Cas12a assay instead of conventional PCR."
      ],
      "photos": [
        "image11.jpeg"
      ],
      "sourceBlock": 56,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 12,
      "title": "Interview with Professor Tianyi Zhao, Harbin Institute of Technology",
      "summaries": [
        "Discussed DNABERT-based machine learning to improve candidate sequence screening and multiplex detection specificity."
      ],
      "photos": [
        "image12.jpeg"
      ],
      "sourceBlock": 60,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 13,
      "title": "Interview with Professor Xingfang Li, University of Alberta",
      "summaries": [
        "Discussed molecular docking and dynamics simulations to assess candidate structural stability before wet-lab experiments."
      ],
      "photos": [
        "image13.jpeg"
      ],
      "sourceBlock": 64,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 14,
      "title": "Interview with Professor Tsan-Yuk Lam, University of Hong Kong",
      "summaries": [
        "Developed optimization strategies for one-pot interference using single-factor gradients and comprehensive controls."
      ],
      "photos": [
        "image14.png"
      ],
      "sourceBlock": 68,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 15,
      "title": "Interview with Professor Zheng Hu and Professor Yingtao Zhang, Harbin Institute of Technology",
      "summaries": [
        "Integrated expert recommendations on temperature control, microcomputing, and computer vision for automated fluorescence analysis."
      ],
      "photos": [
        "image15.jpeg"
      ],
      "sourceBlock": 73,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 16,
      "title": "Collecting First-Generation Instrument Feedback from Nursing Homes",
      "summaries": [
        "Nursing-home trials revealed limitations of single-channel testing, motivating a multi-channel instrument upgrade."
      ],
      "photos": [
        "image16.jpeg"
      ],
      "sourceBlock": 77,
      "type": "FIELD VISIT"
    },
    {
      "number": 17,
      "title": "Collecting First-Generation Instrument Feedback from Kindergartens",
      "summaries": [
        "Kindergarten feedback highlighted the need for faster, higher-throughput screening during sudden fevers."
      ],
      "photos": [
        "image17.jpeg"
      ],
      "sourceBlock": 81,
      "type": "FIELD VISIT"
    },
    {
      "number": 18,
      "title": "Interview with Professor Ying Mou, Zhejiang University",
      "summaries": [
        "Implemented rotational switching and thermal isolation recommendations in the second-generation 15-well instrument."
      ],
      "photos": [
        "image18.png"
      ],
      "sourceBlock": 85,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 19,
      "title": "The “Auditory and Tactile” Blind-Testing Box for Older Adults and The “Monster Capture” Sticker Wall for Children",
      "summaries": [
        "Collected 60 votes from older adults, with 70% positive feedback on device usability.",
        "Used sticker voting with 50 children, finding 64% expressed positive feelings toward screening."
      ],
      "photos": [
        "image19.jpeg"
      ],
      "sourceBlock": 89,
      "type": "VOTING"
    },
    {
      "number": 20,
      "title": "The Retrospective Empathy Survey for Patients",
      "summaries": [
        "Surveyed 200 patients; 90% preferred mobile displays and 85% reported reduced anxiety with bedside testing."
      ],
      "photos": [
        "image20.jpeg"
      ],
      "sourceBlock": 97,
      "type": "VOTING"
    },
    {
      "number": 21,
      "title": "Interview with Director Linshen Xie, West China Fourth Hospital of Sichuan University",
      "summaries": [
        "Discussed quality control, exception handling, data traceability, and public health integration for responsible deployment."
      ],
      "photos": [
        "image21.jpeg"
      ],
      "sourceBlock": 103,
      "type": "EXPERT INTERVIEW"
    },
    {
      "number": 22,
      "title": "Communication with Medical Device Manufacturing Enterprise",
      "summaries": [
        "Reviewed production feasibility, material safety, certification, and cost reduction with medical device engineers."
      ],
      "photos": [
        "image22.jpeg"
      ],
      "sourceBlock": 107,
      "type": "EXPERT INTERVIEW"
    },
