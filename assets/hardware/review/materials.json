      "Reaction area",
      "Fixed observation area; total tube capacity not specified in the source.",
      "Three-sided rotating chamber; five tube slots per side, 15 positions in total. The camera images them sequentially."
    ],
    [
      "Dedicated lysis area",
      "No separate lysis area.",
      "Independent front heating zone with two tube positions, separate from the main reaction area."
    ],
    [
      "Heating and temperature control",
      "Two ceramic heaters, 6 W total; 18B20 sensor; PID/PWM regulation; fan-assisted cooling.",
      "Separate heating structures and temperature feedback for the lysis and main reaction areas. Power and measured temperature-control values were not provided."
    ],
    [
      "Fluorescence acquisition",
      "Blue LED, optical filter and USB macro camera; enclosed housing blocks ambient light.",
      "Fixed camera captures the rotating chamber faces in sequence. Multi-position images and region annotations are documented."
    ],
    [
      "Power and ports",
      "Lithium battery pack with charging, protection and charge-level indicator circuits.",
      "Power board: 12 V input; 5 V and 3.3 V outputs. Rear: USB Type-A, RJ45, USB Type-C, DC 12 V and power switch. Removable battery compartment at the bottom."
    ],
    [
      "Computing and control",
      "Raspberry Pi for image computation.",
      "RK3588 for image processing; STM32F407ZGT6 controller on the main board."
    ],
    [
      "Image processing",
      "YOLOv8n locates reaction tubes; OpenCV extracts and analyzes image regions.",
      "Existing image-analysis pipeline adapted to multiple observation faces and tube positions."
    ],
